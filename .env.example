# ---------------------------------------------------------------------------
# apps/api  ->  copie para apps/api/.env.local e para as Environment Variables
#               do projeto na Vercel. NUNCA versione os valores reais.
# ---------------------------------------------------------------------------

# Connection string da branch do Neon (use a branch "dev" em desenvolvimento).
# Formato: postgresql://user:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Segredo de assinatura dos access tokens (HS256).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Envio de e-mail da recuperacao de senha (Fase 4). Opcional ate la.
RESEND_API_KEY=
RESEND_FROM="Gestao Saude <nao-responda@seudominio.com.br>"

# Base usada para montar o link do e-mail de recuperacao de senha.
APP_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# apps/mobile  ->  copie para apps/mobile/.env
#                  ATENCAO: tudo com prefixo EXPO_PUBLIC_ e embutido no bundle
#                  do app e e visivel para quem baixar o APK. Nada de segredo.
# ---------------------------------------------------------------------------

# Emulador Android:   http://10.0.2.2:3000
# Celular fisico:     http://<ip-da-sua-maquina>:3000
# Recomendado:        a URL do preview deployment da Vercel
EXPO_PUBLIC_API_URL=http://localhost:3000

# Assistente de saude (Groq). Gere em console.groq.com/keys.
# Fica SO no servidor: o aplicativo nunca fala com o Groq direto.
GROQ_API_KEY=

# Geocodificacao dos enderecos dos medicos (MapTiler), chave PRIVADA.
MAPTILER_PRIVATE_KEY=
