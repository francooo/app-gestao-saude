{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["gru1"],
  "functions": {
    "api/rotas.ts": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/api/:caminho*", "destination": "/api/rotas?caminho=:caminho*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
