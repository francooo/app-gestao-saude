# Endereco da API (apps/api). So o servidor (BFF) le: nao vai para o navegador.
# Em desenvolvimento: http://localhost:3000 (pnpm api:dev) ou um preview da Vercel.
API_URL=http://localhost:3000

# Chave PUBLICA do MapTiler para desenhar o mapa. Vai embutida no pacote:
# restrinja-a ao dominio do site no painel do MapTiler. Nunca use aqui a chave
# de geocodificacao da API.
VITE_MAPTILER_KEY=
